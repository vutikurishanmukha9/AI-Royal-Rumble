# ──────────────────────────────────────────────────────────────
#  AI Royal Rumble — Frontend Environment Variables
# ──────────────────────────────────────────────────────────────
#
#  LOCAL DEV:
#    cp .env.example .env
#    Then: npm run dev
#
#  DEPLOYMENT (Vercel / Netlify):
#    Set this in your platform's dashboard under
#    "Environment Variables".
#
#  Vite exposes env vars prefixed with VITE_ to client code.
# ──────────────────────────────────────────────────────────────

# ─── Backend API URL ─────────────────────────────────────────
# Local:   http://localhost:8000/api/v1
# Render:  https://your-backend.onrender.com/api/v1
# Railway: https://your-backend.up.railway.app/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
