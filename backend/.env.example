# ──────────────────────────────────────────────────────────────
#  AI Royal Rumble — Backend Environment Variables
# ──────────────────────────────────────────────────────────────
#
#  QUICK START (local dev):
#    1. Copy this file:  cp .env.example .env
#    2. Fill in at least 2 AI API keys
#    3. Run:  docker-compose up --build
#
#  DEPLOYMENT (Render / Railway):
#    Set these vars in your platform's dashboard.
#    DATABASE_URL and REDIS_URL are auto-injected by managed
#    add-ons — you only need to set API keys + app config.
# ──────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
# Local dev uses docker-compose Postgres.
# Render/Railway: auto-injected by managed PostgreSQL add-on.
# NOTE: Render gives "postgres://" — our config.py auto-converts
# it to "postgresql+asyncpg://" so no manual transform needed.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/airoyalrumble

# ─── Redis ───────────────────────────────────────────────────
# Local dev uses docker-compose Redis.
# Render/Railway: auto-injected by managed Redis add-on.
REDIS_URL=redis://localhost:6379/0

# ─── AI API Keys ─────────────────────────────────────────────
# At least 2 required for a functional rumble.
# Missing keys = that AI is marked inactive (not a crash).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
GROQ_API_KEY=
ALIBABA_API_KEY=
MOONSHOT_API_KEY=

# ─── App Config ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string-in-production

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# UPDATE these when you deploy your frontend!
#
# Vercel:  https://your-app.vercel.app
# Netlify: https://your-app.netlify.app
# Custom:  https://yourdomain.com
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_RUMBLES_PER_IP_PER_HOUR=5
RATE_LIMIT_VOTES_PER_IP_PER_HOUR=20
MAX_CONCURRENT_RUMBLES=50

# ─── AI Token Limits (cost protection) ──────────────────────
MAX_TOKENS_PER_AI_JAM=300
MAX_TOKENS_PER_AI_GD_TURN=250
MAX_GD_ROUNDS=3
VOTING_WINDOW_SECONDS=300

# ─── Advanced ────────────────────────────────────────────────
STREAM_BUFFER_MAX_EVENTS=1000
RUMBLE_LOCK_TTL_SECONDS=900
AUTO_CREATE_TABLES=false
